# ==============================================================================
# JobPortal AI Frontend — Production Environment
# ==============================================================================

# Backend REST API Base URL (HTTPS — for all Axios REST calls)
VITE_API_URL=https://jobportal-backend-20q9.onrender.com/api

# Backend WebSocket URL (WSS — for native WebSocket / STOMP brokerURL)
# Must use wss:// (not https://) for the @stomp/stompjs Client.brokerURL.
# The Spring Boot WebSocket endpoint is /ws on the same host.
VITE_WS_URL=wss://jobportal-backend-20q9.onrender.com/ws
