# =============================================================================
# JobPortal AI Backend — Environment Variables Template
# Copy this file to .env (or set these in your production host environment)
# DO NOT commit real production passwords or API keys to version control!
# =============================================================================

# Server Port
PORT=8080

# Spring Active Profile: local | prod
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/jobportal
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# JWT Security
JWT_SECRET=your_super_secret_64_character_key_here_for_hmac_sha256_algorithm
JWT_EXPIRATION_MS=28800000

# Auth Cookie
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# CORS / Frontend Origins (comma-separated for multiple)
FRONTEND_URL=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Brevo Transactional Email Service (Direct HTTPS REST API)
BREVO_API_KEY=your_brevo_api_key_here
MAIL_FROM=namijojo5687@gmail.com
MAIL_FROM_NAME=JobPortal AI

# Spring AI / Groq API
AI_API_KEY=your_groq_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# Admin Bootstrap (Creates initial admin if none exists)
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_NAME=Platform Admin
ADMIN_BOOTSTRAP_EMAIL=admin@jobportal.com
ADMIN_BOOTSTRAP_PASSWORD=YourAdminSecurePassword@123

# File Storage
FILE_UPLOAD_DIR=uploads

# Async Thread Pool
ASYNC_CORE_POOL_SIZE=5
ASYNC_MAX_POOL_SIZE=25
ASYNC_QUEUE_CAPACITY=500
